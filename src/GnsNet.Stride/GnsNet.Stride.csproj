<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GnsNet.Stride</RootNamespace>
    <AssemblyName>GnsNet.Stride</AssemblyName>
    <PackageId>GnsNet.Stride</PackageId>
    <Version>0.1.0-alpha.1</Version>
    <Description>Stride presentation adapter for GNS.NET authoritative replication.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Engine" Version="$(StrideVersion)" />
    <PackageReference Include="Stride.Games" Version="$(StrideVersion)" />
    <ProjectReference Include="..\GnsNet\GnsNet.csproj" />
  </ItemGroup>
</Project>
