# PlayFab title id from Game Manager (never commit the real secret key).
PLAYFAB_TITLE_ID=
PLAYFAB_SECRET_KEY=
# A client session ticket returned by a PlayFab Client Login API.
PLAYFAB_SESSION_TICKET=

# EOS Connect (used by an EOS-backed validation service, not by the GNS.NET client).
EOS_VALIDATION_ENDPOINT=https://auth.example.com/verify/eos-connect
EOS_DEPLOYMENT_ID=
EOS_SANDBOX_ID=
EOS_CLIENT_ID=
EOS_NONCE=
